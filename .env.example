# LifeLink AI — Environment Variables Template
#
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in all values marked with <REPLACE>
#   3. NEVER commit the .env file to Git
#   4. Keep this .env.example file up to date whenever new variables are added
#
# See ARCHITECTURE.md Section 29 for full deployment notes.

# =============================================================================
# APPLICATION
# =============================================================================

APP_ENV=development
# Options: development | production
# In production, set to: production

APP_NAME=LifeLink AI
APP_VERSION=1.0.0

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<REPLACE_WITH_256_BIT_SECRET>

# JWT token expiry
ACCESS_TOKEN_TTL=900        # 15 minutes in seconds
REFRESH_TOKEN_TTL=604800    # 7 days in seconds

# =============================================================================
# DATABASE — PostgreSQL
# =============================================================================

# Format: postgresql+asyncpg://{user}:{password}@{host}:{port}/{dbname}
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/lifelink

# Database pool settings
DB_POOL_MIN=5
DB_POOL_MAX=20

# =============================================================================
# CACHE — Redis
# =============================================================================

REDIS_URL=redis://localhost:6379/0

# =============================================================================
# AI SERVICE (Internal — never exposed to the internet)
# =============================================================================

AI_SERVICE_URL=http://localhost:8001
# In Docker: http://ai-service:8001

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AI_SERVICE_API_KEY=<REPLACE_WITH_AI_INTERNAL_API_KEY>

# AI model settings
AI_MATCHING_TIMEOUT_SECONDS=5
AI_MAX_DONORS_PER_MATCH=10
AI_DEFAULT_SEARCH_RADIUS_KM=50

# =============================================================================
# FIREBASE — Push Notifications
# =============================================================================

# Download service account JSON from Firebase Console:
# Project Settings → Service Accounts → Generate New Private Key
# Then base64-encode the file:
#   base64 -i firebase-credentials.json
FIREBASE_CREDENTIALS_JSON=<REPLACE_WITH_BASE64_ENCODED_FIREBASE_JSON>

# =============================================================================
# EMAIL — SMTP
# =============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<REPLACE_WITH_EMAIL_ADDRESS>
SMTP_PASSWORD=<REPLACE_WITH_APP_PASSWORD>
# For Gmail: use App Password (not your account password)
# Google Account → Security → 2FA → App Passwords

SMTP_FROM_NAME=LifeLink AI
SMTP_FROM_EMAIL=<REPLACE_WITH_EMAIL_ADDRESS>

# =============================================================================
# MAPS — Geocoding
# =============================================================================

# Default: OpenStreetMap Nominatim (free, no key required)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Optional: Google Maps API (for v2.0 upgrade)
# Enable billing in Google Cloud Console before use
GOOGLE_MAPS_API_KEY=

# =============================================================================
# FRONTEND
# =============================================================================

NEXT_PUBLIC_API_BASE_URL=http://localhost/api/v1
NEXT_PUBLIC_APP_NAME=LifeLink AI
NEXT_PUBLIC_APP_VERSION=1.0.0

# =============================================================================
# CORS
# =============================================================================

# Comma-separated list of allowed origins
# Development: http://localhost:3000
# Production: https://lifelink.ai
CORS_ALLOWED_ORIGINS=http://localhost:3000

# =============================================================================
# RATE LIMITING
# =============================================================================

RATE_LIMIT_GENERAL=100        # requests per minute per IP
RATE_LIMIT_LOGIN=5            # failed login attempts per 15 min per IP
RATE_LIMIT_REGISTER=10        # registrations per hour per IP

# =============================================================================
# LOGGING
# =============================================================================

LOG_LEVEL=INFO
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Use DEBUG only in development

# =============================================================================
# DEPLOYMENT (Production Only)
# =============================================================================

# Set these only when APP_ENV=production

# Domain name for HTTPS (Let's Encrypt via Certbot)
DOMAIN=lifelink.ai

# SSL certificate paths (auto-managed by Certbot)
SSL_CERT_PATH=/etc/letsencrypt/live/lifelink.ai/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/lifelink.ai/privkey.pem
