# LifeLink AI — Backend Service Environment Variables Template
#
# Copy this file: cp .env.example .env
# Fill in the real credentials. Do not commit .env to Git.

APP_ENV=development
APP_NAME=LifeLink AI
APP_VERSION=1.0.0-alpha

# JWT Security
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<REPLACE_WITH_256_BIT_SECRET>
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/lifelink
DB_POOL_MIN=5
DB_POOL_MAX=20

# Cache
REDIS_URL=redis://localhost:6379/0

# AI Service
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_API_KEY=<REPLACE_WITH_AI_INTERNAL_API_KEY>

# Firebase push notification credentials (base64 encoded JSON)
FIREBASE_CREDENTIALS_JSON=

# SMTP email setup
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=LifeLink AI
SMTP_FROM_EMAIL=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
